<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.5</Version>
  </PropertyGroup>

    <PropertyGroup>
        <PackageId>Blazor.Lottie.Player</PackageId>
        <AssemblyName>Blazor.Lottie.Player</AssemblyName>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>Nuget.png</PackageIcon>
        <Company>MudXtra</Company>
        <Authors>Versile and Contributors</Authors>
        <Copyright>Copyright 2025 MudXtra</Copyright>
        <PackageTags>Blazor, Component, Blazor Components, Blazor Library, Lottie, Lottie Player, Lottie Animations</PackageTags>
        <Description>A component wrapper to display Lottie Animations in Blazor.</Description>
        <PackageProjectUrl>https://mudx.org/docs/lottieplayer</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/MudXtra/LottiePlayer</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(TargetFramework)' == 'net11.0' ">
        <!-- BL0016 is a new .NET 11 analyzer (unguarded JS interop). Fixing it means adding try/catch, a behavior change outside the upgrade scope; tracked in the bug review. -->
        <NoWarn>$(NoWarn);BL0016</NoWarn>
    </PropertyGroup>

    <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Blazor.Lottie.Player.UnitTests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include=".\wwwroot\Nuget.png">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>    
    
  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="8.0.34" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.34" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="8.0.34" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="9.0.23" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.23" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="9.0.23" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net11.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="11.0.0" />
  </ItemGroup>

</Project>
